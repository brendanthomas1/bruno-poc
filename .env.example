# Copy this file to `.env` (same folder) and paste your real token.
# `.env` is gitignored, so the token never leaves your machine.
#
# Get it from https://www.themoviedb.org/settings/api -> "API Read Access Token"
# (the long v4 token that starts with "eyJ...", NOT the short v3 "API Key").
TMDB_READ_ACCESS_TOKEN=paste-your-tmdb-v4-read-access-token-here
